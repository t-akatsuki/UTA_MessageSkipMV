# =============================================================================
# EditorConfig設定ファイル
# https://EditorConfig.org
# =============================================================================
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,config.mjs,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.sh]
end_of_line = lf

[Makefile]
indent_style = tab
